{
  "name": "kkojilryong-desktop",
  "productName": "꼬질룡",
  "version": "0.2.0",
  "description": "데스크탑 한 구석에 사는 디지털 반려 공룡. (Electron 본체)",
  "license": "MIT",
  "author": "gkjuwon-tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/gkjuwon-tech/-.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "lint": "tsc -p . --noEmit",
    "sim": "tsc -p tsconfig.sim.json --noEmit false --outDir dist-sim && node dist-sim/sim/ragSim.js && node dist-sim/sim/endingSim.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "com.kkojilryong.desktop",
    "productName": "꼬질룡",
    "artifactName": "kkojilryong-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/sim/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "꼬질룡"
    },
    "portable": {
      "artifactName": "kkojilryong-portable-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": ["dmg"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": ["AppImage"]
    }
  }
}
